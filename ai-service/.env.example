# EcoSphere AI Service - Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=8000
ENVIRONMENT=development

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/embedding-001

# MongoDB Atlas (same connection as Node.js backend)
MONGODB_URI=mongodb://localhost:27017/ecosphere_ai
MONGODB_DB_NAME=ecosphere_ai

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=ecosphere_documents

# Node.js Backend URL (for internal calls if needed)
NODE_BACKEND_URL=http://localhost:5000

# AI Pipeline Tuning
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVAL_DOCS=5
CONFIDENCE_THRESHOLD=0.7
